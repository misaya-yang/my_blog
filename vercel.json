{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "dist/public/{index.html,.vite/manifest.json}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=31536000"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/post/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/algorithms",
      "destination": "/api/index"
    },
    {
      "source": "/applications",
      "destination": "/api/index"
    },
    {
      "source": "/archive",
      "destination": "/api/index"
    },
    {
      "source": "/search",
      "destination": "/api/index"
    },
    {
      "source": "/about",
      "destination": "/api/index"
    },
    {
      "source": "/login",
      "destination": "/api/index"
    },
    {
      "source": "/manage",
      "destination": "/api/index"
    },
    {
      "source": "/manage/agent",
      "destination": "/api/index"
    },
    {
      "source": "/write",
      "destination": "/api/index"
    },
    {
      "source": "/write/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/tags/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/categories/:slug",
      "destination": "/api/index"
    },
    {
      "source": "/404",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/api/index"
    }
  ]
}
