# Supabase/Postgres
# Runtime should use the Supabase shared/transaction pooler URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres"

# Migrations should prefer a direct or session-pooler URL when available.
MIGRATION_DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"
# DIRECT_URL can be used instead of MIGRATION_DATABASE_URL.
# DIRECT_URL=""

# App auth/session
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
JWT_SECRET="replace-with-a-long-random-secret"
OWNER_OPEN_ID="replace-with-owner-open-id"
OWNER_NAME="Admin"
SITE_URL="https://example.com"
VITE_SITE_URL="https://example.com"

# Manus OAuth
VITE_APP_ID="replace-with-app-id"
VITE_OAUTH_PORTAL_URL="https://replace-with-oauth-portal.example"
OAUTH_SERVER_URL="https://replace-with-oauth-server.example"

# Optional Manus/Forge services used by image, map, and transcription helpers.
BUILT_IN_FORGE_API_URL="https://api.deepseek.com"
BUILT_IN_FORGE_API_KEY=""
BLOG_AGENT_MODEL="deepseek-v4-flash"
AI_ANONYMOUS_DAILY_LIMIT="2"
AI_VISITOR_DAILY_LIMIT="6"
AI_ADMIN_DAILY_LIMIT="200"
AI_ANONYMOUS_DAILY_FILE_LIMIT="1"
AI_VISITOR_DAILY_FILE_LIMIT="3"
AI_ADMIN_DAILY_FILE_LIMIT="100"
VITE_FRONTEND_FORGE_API_URL=""
VITE_FRONTEND_FORGE_API_KEY=""

# Optional analytics script in client/index.html.
VITE_ANALYTICS_ENDPOINT=""
VITE_ANALYTICS_WEBSITE_ID=""
